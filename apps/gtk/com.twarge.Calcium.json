{
  "//": "Flatpak manifest. Build on Linux with: flatpak-builder --user --install build-dir apps/gtk/com.twarge.Calcium.json. Before submitting to Flathub, generate cargo-sources.json from apps/gtk/Cargo.lock with flatpak-cargo-generator (flathub/flatpak-builder-tools) so the build works offline, and point the git source at a pushed tag.",
  "app-id": "com.twarge.Calcium",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "calcium-gtk",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--filesystem=home"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": { "CARGO_HOME": "/run/build/calcium/cargo" }
  },
  "modules": [
    {
      "name": "calcium",
      "buildsystem": "simple",
      "build-commands": [
        "cd apps/gtk && cargo --offline build --release",
        "install -Dm755 apps/gtk/target/release/calcium-gtk /app/bin/calcium-gtk",
        "install -Dm644 apps/gtk/data/com.twarge.Calcium.desktop /app/share/applications/com.twarge.Calcium.desktop",
        "install -Dm644 apps/gtk/data/com.twarge.Calcium.metainfo.xml /app/share/metainfo/com.twarge.Calcium.metainfo.xml",
        "install -Dm644 apps/gtk/data/com.twarge.Calcium.png /app/share/icons/hicolor/1024x1024/apps/com.twarge.Calcium.png"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/twarge/calcium.git",
          "tag": "v0.1.0"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
